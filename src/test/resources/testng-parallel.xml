<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="BDD Selenium Framework — Parallel" verbose="1"
       thread-count="4" data-provider-thread-count="4">

    <listeners>
        <listener class-name="com.automation.core.AllureTestListener"/>
    </listeners>

    <test name="Parallel Regression Tests">
        <classes>
            <class name="com.automation.runners.ParallelTestRunner"/>
        </classes>
    </test>

</suite>
